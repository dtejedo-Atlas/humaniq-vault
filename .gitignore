# ===========================================
# Humaniq Talent Vault - .gitignore
# ===========================================

# ============ ARCHIVOS SENSIBLES ============

# Variables de entorno (credenciales)
.env
.env.local
.env.*.local
*.env
backend/.env
frontend/.env

# ============ DATOS DE USUARIOS ============

# CVs y documentos subidos
backend/uploads/
uploads/

# Exports generados (shortlists PDF/DOCX)
backend/exports/
exports/

# Archivos de documentos (pueden contener datos personales)
*.pdf
*.docx
*.doc
*.xlsx
*.xls
*.pptx
*.ppt

# ============ ARCHIVOS DE TEST ============

# CVs de prueba en raíz
test_cv.docx
maria_ops.docx
carlos_cfo.docx
carlos_variant.docx
*.test.pdf
*.test.docx

# Archivos temporales de test
/tmp/
*.tmp

# ============ PYTHON ============

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.venv/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/

# Pytest
.pytest_cache/
.coverage
htmlcov/

# ============ NODE.JS / FRONTEND ============

# Dependencies
node_modules/
frontend/node_modules/

# Build output
frontend/build/
frontend/dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============ IDE / EDITOR ============

# VS Code
.vscode/
*.code-workspace

# JetBrains
.idea/

# Vim
*.swp
*.swo
*~

# ============ OS FILES ============

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# ============ LOGS ============

*.log
logs/
*.log.*

# ============ BACKUPS ============

*.bak
*.backup
*.old

# ============ EMERGENT PLATFORM ============

# Emergent internal files (keep .emergent folder)
# .emergent/ - DO NOT IGNORE, needed for platform

# ============ SECURITY ============

# Private keys
*.pem
*.key
*.crt
*.p12

# Secrets
secrets.json
credentials.json
service-account*.json
frontend/node_modules/.cache/default-development/0.pack
.env.*
.credentials
